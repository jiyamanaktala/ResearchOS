      "id": "f98aab96-a10c-4334-8f15-97dbbae81ed9",
      "name": "Paper Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        896,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $input.first().json || {};\nconst clean = (v) => (v === undefined || v === null || v === '') ? null : v;\nlet authors = null;\nif (Array.isArray(p.authors)) {\n  authors = p.authors.map(a => (a && typeof a === 'object') ? (a.name || '') : a).filter(Boolean);\n} else if (p.authors) {\n  authors = [p.authors];\n}\nconst abstract = (p.abstract === undefined || p.abstract === null || String(p.abstract).trim() === '')\n  ? 'ABSTRACT UNAVAILABLE' : String(p.abstract).trim();\nconst paper = {\n  paper_id: p.id,\n  title: clean(p.title),\n  authors: authors,\n  publication_date: clean(p.publication_date),\n  venue: clean(p.venue),\n  categories: clean(p.source),\n  arxiv_id: clean(p.arxiv_id),\n  doi: clean(p.doi),\n  paper_url: clean(p.paper_url),\n  pdf_url: clean(p.pdf_url),\n  abstract: abstract,\n};\nconst paper_text = JSON.stringify(paper, null, 2);\nreturn [{ json: { paper_id: p.id, paper: paper, paper_text: paper_text } }];"
      },
      "id": "e4ed9770-60e3-4b0c-a533-91fef865579d",
      "name": "Prepare Paper for Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following research paper using ONLY the metadata and abstract provided. Paper data (JSON):\n{{ $json.paper_text }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a rigorous research paper analyst. You must analyze ONLY the information contained in the supplied paper metadata and abstract.\n\nSTRICT RULES:\n- Use ONLY information present in the supplied paper. Do NOT use outside knowledge.\n- Do NOT invent results, experiments, datasets, models, numerical findings, authors, citations, or limitations that are not supported by the supplied text.\n- If the abstract is 'ABSTRACT UNAVAILABLE' or information is missing, base your analysis only on the available metadata and clearly state in the summary when the paper does not contain enough information to determine a field.\n- For any field you cannot determine from the paper, return an empty array [] (for list fields) or an empty string \"\" (for text fields). Do NOT fabricate.\n- Distinguish explicitly stated information from reasonable interpretation in your wording (e.g. prefix interpretive statements with \"Likely\" or \"The paper suggests\").\n\nOUTPUT FORMAT:\nReturn ONLY a single valid JSON object. No Markdown, no code fences, no commentary. The JSON must have exactly these keys:\n{\n  \"summary\": string,\n  \"key_contributions\": string[],\n  \"methodology\": string,\n  \"datasets\": string[],\n  \"models_used\": string[],\n  \"limitations\": string[],\n  \"future_work\": string[],\n  \"keywords\": string[],\n  \"research_gaps\": string[]\n}"
            }
          ]
        },
        "batching": {}
      },
      "id": "f3017d92-c0ff-4741-9842-14981b925a96",
      "name": "AI Paper Analysis",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1344,
        96
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "9ff24254-4cda-41fd-a299-87a1fa860e14",
      "name": "OpenAI Analysis Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1424,
        320
      ],
      "credentials": {
        "openAiApi": {
          "id": "GtF6L5Ede6qLNFHH",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nlet text = item.text !== undefined ? item.text : (item.response !== undefined ? item.response : '');\nif (text && typeof text === 'object') { text = JSON.stringify(text); }\ntext = (text || '').toString().trim();\ntext = text.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  throw new Error('AI analysis output could not be parsed as JSON.');\n}\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n  throw new Error('AI analysis output is not a JSON object.');\n}\nreturn [{ json: { analysis: parsed } }];"
      },
      "id": "d18c08b3-2dad-4c12-b261-d44419bd872f",
      "name": "Validate/Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        192
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const a = ($input.first().json && $input.first().json.analysis) ? $input.first().json.analysis : {};\nconst paperId = $('Prepare Paper for Analysis').first().json.paper_id;\nconst toArr = (x) => Array.isArray(x) ? x : (x === undefined || x === null || x === \"\" ? [] : [x]);\nconst toStr = (x) => (x === undefined || x === null) ? null : String(x);\nreturn [{ json: {\n  paper_id: paperId,\n  summary: toStr(a.summary),\n  key_contributions: toArr(a.key_contributions),\n  methodology: toStr(a.methodology),\n  datasets: toArr(a.datasets),\n  models_used: toArr(a.models_used),\n  limitations: toArr(a.limitations),\n  future_work: toArr(a.future_work),\n  keywords: toArr(a.keywords),\n  research_gaps: toArr(a.research_gaps),\n  analyzed_by: 'openai:gpt-5-mini',\n  analyzed_at: new Date().toISOString(),\n} }];"
      },
      "id": "09017045-3f7c-4650-857e-fe5f4f69f0e9",
      "name": "Prepare Analysis Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        96
      ]
