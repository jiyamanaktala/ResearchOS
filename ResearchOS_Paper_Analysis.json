      "parameters": {
        "jsCode": "let details = 'Database insertion failed';\ntry {\n  const err = $input.first().json;\n  if (err && err.error) {\n    if (typeof err.error === 'string') details = err.error;\n    else if (err.error.message) details = err.error.message;\n  } else if (err && err.message) { details = err.message; }\n} catch (e) {}\nreturn [{ json: {\n  success: false,\n  message: 'Failed to store paper analysis.',\n  details: details,\n} }];"
      },
