      "id": "b8f7cd28-94fb-4fb1-b921-d439ef387256",
      "name": "Store Paper Analysis",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2144,
        96
      ],
      "credentials": {
        "supabaseApi": {
          "id": "B4y2D5pRDOtwXTFL",
          "name": "Supabase account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const stored = $input.first().json || {};\nconst analysis = $('Prepare Analysis Record').first().json || {};\nconst paperId = analysis.paper_id !== undefined ? analysis.paper_id : stored.paper_id;\nconst record = Object.assign({}, analysis);\nif (stored.id !== undefined) record.id = stored.id;\nif (stored.created_at !== undefined) record.created_at = stored.created_at;\nreturn [{ json: {\n  success: true,\n  message: 'Paper analyzed successfully',\n  paper_id: paperId,\n  analysis: record,\n} }];"
      },
