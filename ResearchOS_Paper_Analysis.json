    {
      "parameters": {
        "jsCode": "const root = $input.first().json || {};\nconst body = (root.body && typeof root.body === 'object') ? root.body : root;\nconst raw = body.paper_id;\nconst num = Number(raw);\nconst isValid = raw !== undefined && raw !== null && raw !== '' && Number.isFinite(num) && num > 0;\nreturn [{ json: {\n  paper_id: isValid ? num : null,\n  raw_paper_id: raw === undefined ? null : raw,\n  is_valid: isValid,\n} }];"
      },
      "id": "be5a3ea7-7ed3-4d54-8cdd-b3d3235fac33",
      "name": "Normalize Analysis Input",
